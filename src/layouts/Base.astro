---
/* The <head> every page shares. Company pages and Library pages
   put very different bodies inside it. */
import { SITE } from '../site.config.js';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  themeColor?: string;
  published?: string;
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  imageAlt = 'A banknote reading: Give me one dollar.',
  type = 'website',
  themeColor = '#f7f4ec',
  published,
} = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(path, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="Asking Company — The Library" href="/rss.xml">
<meta name="theme-color" content={themeColor}>

<meta property="og:type" content={type}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={imageUrl}>
<meta property="og:image:alt" content={imageAlt}>
<meta property="og:locale" content="en_CA">
{published && <meta property="article:published_time" content={published}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={imageUrl}>
<slot name="head" />
</head>
<slot />
</html>
