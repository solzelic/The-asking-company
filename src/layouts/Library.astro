---
/* The Library: the quiet half. No ticker, no banknote frames.
   `tone` is 'dark' for the reading room, 'light' for an essay. */
import Base from './Base.astro';
import { SITE } from '../site.config.js';
import '../styles/library.css';

interface Props {
  title: string;
  description?: string;
  tone?: 'dark' | 'light';
  image?: string;
  type?: 'website' | 'article';
  published?: string;
  accent?: string;
  progress?: boolean;
}
const { title, description, tone = 'dark', image, type, published, accent, progress = false } = Astro.props;
const onIndex = Astro.url.pathname.replace(/(\.html|\/)$/, '') === '/writing';
---
<Base title={title} description={description} image={image} type={type} published={published}
      themeColor={tone === 'dark' ? '#14110c' : '#f7f4ec'}>
<body class={tone} style={accent ? `--accent:${accent}` : undefined}>
  <header class="lbar" id="lbar">
    <div class="lbar-in">
      <a class="lbrand" href="/writing">
        <span class="seal">¶</span>
        <span class="t">The Library<i>of Asking Company</i></span>
      </a>
      <nav class="llinks" aria-label="Library">
        <a href="/writing" class:list={[{ on: onIndex }]}>All writing</a>
        <a href="/prospectus" class="hide-s">The Company</a>
        <a href="/" class="give">Give $1</a>
      </nav>
    </div>
    {progress && <div class="progress" id="progress"></div>}
  </header>

  <slot />

  <footer class="lfoot">
    <a href="/">The Ask</a>·<a href="/writing">The Library</a>·<a href="/rss.xml">RSS</a>·<a href="/terms">Terms</a>·<a href={`mailto:${SITE.email}`}>Email</a>
    <br>Asking Company · Toronto
  </footer>

  <script>
    // Bar hides on the way down. Reading progress, if there is a bar for it.
    const bar = document.getElementById('lbar');
    const prog = document.getElementById('progress');
    let lastY = 0;
    addEventListener('scroll', () => {
      const y = scrollY;
      bar?.classList.toggle('hide', y > 160 && y > lastY);
      lastY = y;
      if (prog) {
        const max = document.documentElement.scrollHeight - innerHeight;
        prog.style.setProperty('--p', String(max > 0 ? Math.min(1, y / max) : 0));
      }
    }, { passive: true });
  </script>
  <script>import '../scripts/subscribe.js';</script>
</body>
</Base>
