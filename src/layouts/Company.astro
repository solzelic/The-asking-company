---
/* The company: the joke. Banknote frames, hard shadows, one spot
   ink per page, a ticker that never stops. */
import Base from './Base.astro';
import { SITE, THEME, NAV_PRIMARY, NAV_COMPANY } from '../site.config.js';
import '../styles/company.css';

interface Props {
  title: string;
  description?: string;
  page: keyof typeof THEME;
  closer?: boolean;
}

const { title, description, page, closer = true } = Astro.props;
const t = THEME[page];

const MARQ = ['Give me one dollar', '$1', 'Nobody asked', '$1', 'One in eight people', '$1',
  'No equity', '$1', 'Nothing in return', '$1', 'Management remains bullish', '$1'];
---
<Base title={title} description={description}>
<slot name="head" slot="head" />
<body data-page={page} style={`--spot:${t.spot};--spot-soft:${t.soft}`}>

<div class="stock"></div>

<div class="nav" id="nav">
  <div class="nav-in">
    <a class="brand" href="/">
      <span class="seal">$</span>
      <span class="nm">Asking Company</span>
    </a>
    <div class="navright">
      <nav class="primary" aria-label="Primary">
        {NAV_PRIMARY.map(n => (
          <a href={n.href} data-p={n.p} class:list={[{ on: n.p === page, lib: n.p === 'writing' }]}>{n.label}</a>
        ))}
      </nav>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="menu" id="menu" aria-label="Everything">
      <div class="mgroup">The Ask</div>
      {NAV_PRIMARY.map(n => <a href={n.href} class:list={[{ on: n.p === page }]}>{n.label}</a>)}
      <div class="mgroup">The Company</div>
      {NAV_COMPANY.map(n => <a href={n.href} class:list={[{ on: n.p === page }]}>{n.label}</a>)}
    </nav>
  </div>
</div>

<div class="shell">
  <div class="marq" aria-hidden="true"><div class="marq-in">
    {[...MARQ, ...MARQ].map(m => <span>{m}</span>)}
  </div></div>

  <main class="wrap">
    <slot />

    {closer && (
      <div class="closer">
        <span class="eyebrow">In Closing</span>
        <h2>One dollar. That's it.</h2>
        <div style="margin-top:26px"><button class="btn" data-ask="1">Give me one dollar</button></div>
      </div>
    )}
  </main>

  <footer>
    <div class="wrap">
      <div class="grid g2">
        <div class="fcol"><div class="k">Registered office</div><p class="dim" style="font-size:14px">Toronto, Ontario<br>Canada</p></div>
        <div class="fcol"><div class="k">Investor relations</div><p class="dim" style="font-size:14px">There are no investors.<br>There is no relations.</p></div>
        <div class="fcol"><div class="k">Contact</div><p class="dim" style="font-size:14px">We would prefer the dollar.<br><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p></div>
        <div class="fcol"><div class="k">Elsewhere</div><p class="dim" style="font-size:14px"><a href="/writing">The Library</a><br><a href="/terms">Terms &amp; refunds</a> · <a href="/rss.xml">RSS</a></p></div>
      </div>
      <p class="legal">
        Asking Company is a satirical project. Nothing on this site is an offer to sell or a
        solicitation of an offer to buy any security, and no security, equity, share, unit, token,
        or ownership interest of any kind exists or is contemplated. A payment made here buys one
        digital Certificate of Nothing, delivered immediately on screen. It is not an investment, a
        loan, or a donation to a registered charity, and nothing further is promised or owed. Not tax
        deductible. Financial figures are real but trivial. Forward-looking statements are almost
        certainly false. Persons named as employees do not work here and have not been contacted.
        Full <a href="/terms">terms of sale and refund policy</a>.
      </p>
    </div>
  </footer>
</div>

<div id="modalRoot"></div>

<script>
  import '../scripts/nav.js';
  import '../scripts/ask.js';
</script>
</body>
</Base>
