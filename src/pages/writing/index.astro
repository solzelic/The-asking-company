---
import Library from '../../layouts/Library.astro';
import Book from '../../components/Book.astro';
import { getBooks, getPlanned, SERIES } from '../../lib/library.js';

const books = await getBooks();
const planned = getPlanned();
const all = [...books, ...planned];

const tagCounts = new Map();
for (const b of books) for (const t of b.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const shelves = SERIES.filter(s => all.some(b => b.series === s.id));
const totalWords = books.reduce((s, b) => s + b.words, 0);
let n = 0;
---
<Library title="The Library — Asking Company"
  description="Longer pieces, bound and shelved. Essays from the founder of Asking Company, some for the company and some for their own sake.">
  <div class="room" id="room">
    <div class="rwrap">
      <header class="rhead">
        <span class="kick">The Library</span>
        <h1>Things written <em>down.</em></h1>
        <p>Longer pieces, bound and shelved. Some were written for the company. Most were written for their own sake. All of them were written before they were true.</p>
        <div class="stats">
          <span>{books.length} {books.length === 1 ? 'volume' : 'volumes'}</span>
          <span>{totalWords.toLocaleString('en-US')} words</span>
          <span>{planned.length} planned</span>
        </div>
      </header>

      <div class="controls" id="controls">
        <div class="crow">
          <label class="search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="vh">Search the stacks</span>
            <input type="search" id="q" placeholder="Search the stacks…" autocomplete="off">
          </label>
          <div class="seg" role="group" aria-label="Voice">
            <button data-voice="all" aria-pressed="true">All</button>
            <button data-voice="company" aria-pressed="false" title="Written for the company, in its voice">For the company</button>
            <button data-voice="own" aria-pressed="false" title="Written for their own sake">For its own sake</button>
          </div>
          <button class="ctoggle" id="ctoggle" aria-expanded="false" aria-controls="controls">Filters</button>
        </div>
        <div class="crow more-ctl">
          <div class="chips" role="group" aria-label="Shelf">
            <span class="lab">Shelf</span>
            <button class="chip" data-shelf="all" aria-pressed="true">All</button>
            {shelves.map(s => (
              <button class="chip" data-shelf={s.id} aria-pressed="false">{s.name}<span class="n">{books.filter(b => b.series === s.id).length}</span></button>
            ))}
          </div>
        </div>
        {tags.length > 0 && (
          <div class="crow more-ctl">
            <div class="chips" role="group" aria-label="Topic">
              <span class="lab">Topic</span>
              {tags.map(([t, c]) => <button class="chip" data-tag={t} aria-pressed="false">{t}<span class="n">{c}</span></button>)}
            </div>
          </div>
        )}
        <div class="crow more-ctl">
          <label class="vh" for="sort">Sort</label>
          <select class="sel" id="sort">
            <option value="shelf">By shelf</option>
            <option value="new">Newest first</option>
            <option value="old">Oldest first</option>
            <option value="long">Longest first</option>
            <option value="short">Shortest first</option>
            <option value="az">A – Z</option>
          </select>
          <div class="seg" role="group" aria-label="View">
            <button data-view="shelf" aria-pressed="true">Shelf</button>
            <button data-view="index" aria-pressed="false">Index</button>
          </div>
          <label class="toggle"><input type="checkbox" id="planned" checked> Unwritten volumes</label>
          <span class="count" id="count" aria-live="polite"></span>
        </div>
      </div>

      <div class="stacks" id="stacks">
        <div class="shelves">
          {shelves.map(s => (
            <section class="sgroup" data-group={s.id}>
              <div class="shead">
                <div><div class="no">{s.no}</div><h2>{s.name}</h2></div>
                <div class="ct" data-ct></div>
              </div>
              <p class="snote">{s.note}</p>
              <div class="case" data-case={s.id}>
                {all.filter(b => b.series === s.id).map(b => <Book book={b} i={n++} />)}
              </div>
            </section>
          ))}
          <section class="sgroup" data-group="__flat" hidden>
            <div class="shead"><div><div class="no">All shelves</div><h2 data-flat-title>Everything</h2></div></div>
            <p class="snote" data-flat-note></p>
            <div class="case" data-case="__flat"></div>
          </section>
          <p class="empty-all" id="emptyAll" hidden style="text-align:center;font-style:italic;color:var(--cream-60);font-size:20px;padding:40px 0">
            Nothing on the shelves matches. It may not have been written yet.
          </p>
        </div>

        <div class="index" id="index">
          {all.map(b => b.planned ? (
            <div class="irow planned" data-for={b.slug}>
              <span class="no">—</span>
              <div><div class="t"><span class="sw pl"></span>{b.title}</div><div class="d">{b.dek}</div></div>
              <div class="m">not yet written</div>
            </div>
          ) : (
            <a class="irow" href={b.href} data-for={b.slug} style={`--cloth:${b.spine}`}>
              <span class="no">{b.no}</span>
              <div><div class="t"><span class="sw"></span>{b.title}</div><div class="d">{b.dek}</div></div>
              <div class="m">{b.dateLabel}<br>{b.minutes} min · {b.seriesName}</div>
            </a>
          ))}
        </div>
      </div>

      <div class="card-slot"><div class="ccard" id="ccard" aria-hidden="true"></div></div>

      <section class="rsub">
        <h2>Be told when there is something new.</h2>
        <p>A handful of times a year, if that. There is no schedule and we will not invent one.</p>
        <form class="subf" data-subscribe="library" data-done="You are on the list. You will hear from us when something is shelved.">
          <input type="email" required placeholder="you@example.com" autocomplete="email" aria-label="Email address">
          <input type="hidden" name="writings" value="1">
          <button type="submit">Notify me</button>
        </form>
        <p class="subnote">Or follow along by <a href="/rss.xml">RSS</a>.</p>
      </section>
    </div>
    <div class="veil" id="veil"></div>
  </div>
  <script>import '../../scripts/library.js';</script>
</Library>
