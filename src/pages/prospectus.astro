---
import Company from '../layouts/Company.astro';
---
<Company title="Prospectus — Asking Company" description="A complete statement of the business, its market, its method and the risks attaching thereto. Prepared, reviewed and approved by management." page="prospectus">

  <div class="note" style="--corner:'§'">
    <span class="corner tr">&sect;</span><span class="corner bl">&sect;</span>
    <span class="eyebrow">White Paper</span>
    <h2 style="font-size:clamp(32px,6.4vw,54px)">A Prospectus.</h2>
    <p class="dim">Being a complete statement of the business, its market, its method and the
      risks attaching thereto. Prepared by management. Reviewed by management. Approved by
      management.</p>
    <p class="tiny" style="margin-top:18px">Asking Company &middot; Toronto &middot; First edition
      &middot; Printed in one colour to reduce costs</p>
  </div>

  <section class="blk">
    <span class="eyebrow">Abstract</span>
    <div class="panel narrow">
      <p class="lede">We describe a company with one employee, one product and one price. The
        product is a request. The price is one dollar.</p>
      <p class="dim">We show that the resulting business has no marginal cost, no inventory,
        no delivery obligation and no conversion rate, and we argue that the absence of the
        last of these is a feature of the model rather than an omission from it. We conclude
        that the company is the most capital-efficient in its sector and invite correction.</p>
    </div>
  </section>

  <section class="blk">
    <span class="eyebrow">Preface &middot; The Thesis</span>
    <h2>The most capital-efficient company<br>in artificial intelligence.</h2>
    <div class="panel narrow">
      <p class="lede">Everyone keeps saying artificial intelligence will produce the first
        one-person billion-dollar company. It is said on podcasts. It is said in keynotes.
        It is said by the people who run the labs, with great confidence and no examples.</p>
      <p class="dim">We found the absence of examples notable. So we built one, and we would
        now like to make the case for it seriously, because we believe it is the strongest
        case in the sector.</p>

      <h4 style="font-size:13px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--spot);margin:28px 0 10px">Revenue per employee</h4>
      <p class="dim">The industry's favourite metric. Ours is $149. The denominator is 1.
        We invite comparison on the denominator.</p>

      <h4 style="font-size:13px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--spot);margin:28px 0 10px">Gross margin</h4>
      <p class="dim">Our competitors lose money on every unit of inference they serve and
        expect this to improve at scale. We do not serve inference. We serve a sentence.
        A sentence costs nothing to serve and does not get more expensive when more people
        read it.</p>

      <h4 style="font-size:13px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--spot);margin:28px 0 10px">Capital efficiency</h4>
      <p class="dim">Value created divided by capital raised. We have raised zero dollars,
        so the figure requires division by zero and is therefore undefined. We interpret
        this favourably. Our accountant has been instructed to interpret it the same way
        and has not responded.</p>

      <h4 style="font-size:13px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--spot);margin:28px 0 10px">Burn</h4>
      <p class="dim">Two hundred dollars a month. It is one software subscription. We have no
        office, no compute contract, no data centre, no counterparties, and no obligations
        denominated in anything other than politeness.</p>

      <h4 style="font-size:13px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--spot);margin:28px 0 10px">The constraint</h4>
      <p class="dim">Every other company in this sector is constrained by the supply of
        graphics processing units, which is finite, contested, and becoming more expensive.
        We are constrained by the number of people who have heard of us. This is the only
        input in the entire industry that gets cheaper as you use more of it.</p>

      <p style="margin-top:28px"><b>We are not claiming to be a better business. We are
        claiming to be a more efficient one, and we would like somebody to explain the
        difference to us in writing.</b></p>
    </div>
  </section>

  <section class="blk">
    <span class="eyebrow">1 &middot; The Market</span>
    <h2>Everyone.</h2>
    <p class="dim narrow" style="margin:0 auto 24px">Our total addressable market is the human
      species. We are not aware of a larger one.</p>
    <div class="grid g2">
      <div class="tile"><div class="k">TAM</div><div class="v">$8.2B</div>
        <div class="n">Every person alive, at one dollar each.<sup>1</sup></div></div>
      <div class="tile"><div class="k">SAM</div><div class="v">$5.4B</div>
        <div class="n">Those with internet access and a payment method.</div></div>
      <div class="tile"><div class="k">SOM</div><div class="v">$149</div>
        <div class="n">Obtained. Audited by nobody.</div></div>
      <div class="tile"><div class="k">Penetration</div><div class="v">0.0000018%</div>
        <div class="n">Early.</div></div>
    </div>
  </section>

  <section class="blk">
    <span class="eyebrow">The Math</span>
    <h2>One in eight people.</h2>
    <p class="deck dim" style="margin-bottom:24px;max-width:640px">That is the entire go-to-market.</p>
    <div class="grid g3" style="margin-bottom:22px">
      <div class="tile"><div class="k">Givers required</div><div class="v">1 in 8</div>
        <div class="n">People currently alive who must give one dollar, one time.</div></div>
      <div class="tile"><div class="k">Market penetration</div><div class="v">12.2%</div>
        <div class="n">Aggressive. Not unprecedented. Coca-Cola manages more.</div></div>
      <div class="tile"><div class="k">Required retention</div><div class="v">0%</div>
        <div class="n">Nobody has to come back. It is one dollar, once, forever.</div></div>
      <div class="tile"><div class="k">Acquisition cost</div><div class="v">$0</div>
        <div class="n">The product is the marketing. The marketing is the product.</div></div>
      <div class="tile"><div class="k">Net per dollar</div><div class="v">67&cent;</div>
        <div class="n">Stripe takes 33&cent;. We would rather not discuss this.</div></div>
      <div class="tile"><div class="k">Capital efficiency</div><div class="v">&infin;</div>
        <div class="n">Value created over capital raised. Capital raised is zero.</div></div>
    </div>
    <div class="panel spot narrow" style="text-align:left">
      <p style="font-family:var(--mono);font-size:13px;line-height:2;margin:0">
        8,200,000,000 &nbsp;people alive<br>
        &times; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$1.00 &nbsp;each<br>
        = &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$8,200,000,000 &nbsp;total addressable market<br>
        &minus; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$7,200,000,000 &nbsp;we do not need<br>
        <b style="border-top:2px solid var(--ink);display:inline-block;padding-top:6px;margin-top:4px">
        = &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;$1,000,000,000 &nbsp;the goal</b>
      </p>
      <p class="dim" style="font-size:14px;margin-top:18px">
        One in eight. Every consumer company in history would call that an ambitious but
        achievable Year One target. We have been at it since April and have reached
        one in five hundred and forty-seven million.
      </p>
      <p class="faint" style="font-size:13px;font-style:italic;margin-top:12px">
        A correction has been noted. At 67&cent; net of processing we in fact require
        1,490,313,000 givers, or one in 5.5 people alive. Management became aware of this
        during preparation of these figures and has elected to proceed.
      </p>
    </div>
  </section>

  <section class="blk">
    <span class="eyebrow">2 &middot; Method</span>
    <h2>We ask.</h2>
    <div class="panel narrow">
      <p class="dim">The method is asking. A request is transmitted to a person. The person
        either gives one dollar or does not. There is no funnel, no nurture sequence, no
        retargeting and no second touch, because a second touch would be asking twice, which
        is a different company.</p>
      <p class="dim">The request costs nothing to produce and nothing to serve. It does not
        degrade under load. It works in every language and on every device, including devices
        that have not been invented, provided they can display a sentence.</p>
      <p><b>We are not aware of another product in this sector with those properties.</b></p>
    </div>
  </section>

  <section class="blk">
    <span class="eyebrow">3 &middot; Growth Strategy</span>
    <h2>We have found a way to halve<br>the number of people required.</h2>
    <p class="dim narrow" style="margin:0 auto 26px;max-width:640px">
      Our original model required one dollar from one in eight people alive. Following a
      review of our growth assumptions, we have identified a refinement.
    </p>
    <p class="lede" style="text-align:center;margin-bottom:28px"><b>We ask for two dollars.</b></p>

    <div class="strat">
      <div class="strat-head"><span>Sensitivity analysis</span><span>Ask &times; givers = $1,000,000,000</span></div>
      <div class="chips" id="stratChips"></div>
      <div class="readout">
        <div><div class="k">The ask</div><div class="v" id="sAsk">$1</div></div>
        <div><div class="k">Givers required</div><div class="v small" id="sGivers">1,000,000,000</div></div>
        <div><div class="k">Of everyone alive</div><div class="v" id="sRatio">1 in 8.2</div></div>
        <div><div class="k">vs. current plan</div><div class="v" id="sGain">&mdash;</div></div>
      </div>
      <div class="strat-note" id="sNote"></div>
    </div>

    <div class="panel narrow" style="margin-top:26px">
      <p class="dim">We are aware of one objection: that a person asked for two dollars may be
        less likely to give than a person asked for one. We have reviewed this and determined
        it is not a factor in the model, because the model does not contain a conversion rate.
        Adding one would require assumptions we are not currently in a position to make.</p>
      <p style="margin-top:16px"><b>The limit case.</b> At one billion dollars the requirement
        falls to a single person. This is the most efficient version of the strategy and we are
        pursuing it in parallel. If you are that person, the button is at the top of the page
        and will need to be pressed once.</p>
    </div>
  </section>


  <section class="blk">
    <span class="eyebrow">4 &middot; Competitive Landscape</span>
    <h2>What everyone else requires.</h2>
    <p class="dim narrow" style="margin:0 auto 24px">Each competitor in the adjacent-ask
      category carries an obligation we do not.</p>
    <div class="panel" style="padding:0;overflow:hidden">
      <table class="tbl comp">
        <tr><th>Competitor</th><th>Requires</th><th>Our position</th></tr>
        <tr><td>GoFundMe</td><td>A reason</td><td>We do not have one</td></tr>
        <tr><td>Wikipedia</td><td>Articles to fund</td><td>We have written none</td></tr>
        <tr><td>Organised religion</td><td>An afterlife</td><td>Materially higher cost of goods</td></tr>
        <tr><td>Busking</td><td>A skill</td><td>&mdash;</td></tr>
        <tr><td>Venture capital</td><td>Equity</td><td>We offer none, which is cheaper for us</td></tr>
        <tr><td>Employment</td><td>Labour</td><td>Under review</td></tr>
      </table>
    </div>
  </section>

  <section class="blk">
    <span class="eyebrow">5 &middot; Use of Proceeds</span>
    <h2>What happens to the billion.</h2>
    <p class="dim narrow" style="margin:0 auto 24px">Set out in full, in advance, on the theory
      that this is the only point at which writing it down costs nothing to mean.</p>
    <div class="panel">
      <table class="tbl">
        <tr><td>Living expenses &mdash; one million per month</td><td class="r">1.2%</td></tr>
        <tr><td>The founder's mother &mdash; one million per month</td><td class="r">1.2%</td></tr>
        <tr><td>Distributed annually to make new millionaires</td><td class="r">4.6%</td></tr>
        <tr class="tot"><td>Principal, never touched</td><td class="r">93.0%</td></tr>
      </table>
      <p class="tiny">The principal is the engine and is not spent. Only what it throws off is
        distributed. The full argument is set out in <a href="/writing/succession-plan"><i>A succession plan, filed in advance</i></a>,
        Shelf I of <a href="/writing">the Library</a>.</p>
    </div>
  </section>

  <section class="blk">
    <span class="eyebrow">6 &middot; Risk Factors</span>
    <h2>What could go wrong.</h2>
    <p class="dim narrow" style="margin:0 auto 24px">Disclosed in full. Investors are reminded
      that there are no investors.</p>
    <ol class="risks">
      <li><b>People may not give us one dollar.</b> This is the principal risk to the business.
        It is also, at present, the situation.</li>
      <li><b>A competitor may ask for less.</b> We have modelled this. The floor is zero
        dollars, at which point the competitor holds our entire business model and none of our
        revenue. We consider the position defensible.</li>
      <li><b>The founder may lose interest.</b> Historically the leading cause of failure in
        this category. No mitigation has been identified. Management has been made aware and
        did not appear concerned, which we disclose as a separate risk.</li>
      <li><b>We may be instructed to stop.</b> By whom is not established. We have not been
        instructed to stop.</li>
      <li><b>The model contains no conversion rate.</b> Disclosed for completeness. See
        Section 3. Adding one would require assumptions we are not in a position to make and
        would, on any realistic value, make the rest of this document considerably shorter.</li>
      <li><b>Concentration risk.</b> One hundred per cent of revenue derives from asking. We
        have no second product and no plans to build one, as a second product would dilute
        the first.</li>
      <li><b>Key person risk.</b> There is one person. He is also the key.</li>
      <li><b>Currency risk.</b> All figures are expressed in dollars. Should the dollar cease
        to exist, one in eight people will owe us nothing.</li>
      <li><b>We may succeed.</b> Management has not planned for this and has no procedure for
        it. The one document addressing the scenario was written before the company had any
        money, on the assumption that it would be harder to write afterwards.</li>
    </ol>
  </section>


  <section class="blk">
    <span class="eyebrow">7 &middot; Operational Risks</span>
    <h2>How the money actually moves.</h2>
    <p class="dim narrow" style="margin:0 auto 24px">The preceding risks are strategic. These
      are mechanical, and considerably more likely.</p>
    <ol class="risks" start="10">
      <li><b>The payment processor may decline to process payments.</b> Card networks and the
        processors acting for them maintain categories of restricted business. The solicitation
        of funds without a registered charitable purpose sits adjacent to several of them. We
        have described our activity accurately in our application, which is the only mitigation
        available to us and also the single thing most likely to trigger review.</li>

      <li><b>A dispute costs more than the gift.</b> A giver who forgets the transaction and
        queries it with their bank produces a dispute. The fee attaching to that dispute is
        approximately fifteen dollars and is not returned to us even where the dispute is
        resolved in our favour. Successfully defending a one-dollar gift therefore costs us
        fourteen dollars, and our break-even is one dispute per fifteen givers. This is a worse
        ratio than it sounds, because we have had fifteen givers.</li>

      <li><b>Disputes policy.</b> We have accordingly adopted a threshold. Disputes are accepted
        only on transactions exceeding sixteen dollars, at which level a defence resolved in our
        favour leaves us with one dollar &mdash; being the amount we asked for in the first
        place. Below that figure we will not contest the charge, on the basis that winning is
        the more expensive outcome. We are aware that we do not control who raises a dispute,
        or when, or whether any of this is ours to decide. The policy is published for
        completeness.</li>

      <li><b>The descriptor.</b> The charge appears on the giver's statement as ASKINGCOMPANY.
        We have not been able to establish whether this makes a dispute more or less likely, and
        we can see the argument both ways.</li>

      <li><b>Holds and reserves.</b> A processor observing a sudden concentration of small
        one-time payments to an entity with no product may place funds on hold pending review.
        We would like to state for the record that this describes us precisely and that we do
        not consider it unreasonable.</li>

      <li><b>Contingency.</b> Should processing be withdrawn we will move to another provider,
        and then to another. There are more payment processors in the world than there are
        reasons to give us a dollar, and we expect to exhaust the second well before the
        first.</li>

      <li><b>The floor.</b> In the event that no processor will act for us, the founder's
        position is that people have handed each other money without intermediaries for several
        thousand years and that the technology, while dated, is well understood.</li>
    </ol>
  </section>

  <section class="blk">
    <span class="eyebrow">Conclusion</span>
    <div class="panel spot narrow">
      <p class="lede">A company that asks eight billion people for one dollar has no meaningful
        costs, no meaningful obligations and no meaningful defence.</p>
      <p class="dim">We have described the market, the method, the strategy, the competition,
        the allocation of proceeds and the risks. Every figure in this document is real. Every
        conclusion drawn from those figures is available for inspection and, we suspect,
        correction.</p>
      <p><b>The request follows.</b></p>
      <div style="margin-top:26px"><button class="btn" data-ask="1">Give me one dollar</button></div>
    </div>
  </section>

  <section class="blk">
    <span class="eyebrow">Notes</span>
    <ol class="notes">
      <li>Population estimate. We did not conduct the census.</li>
      <li>Assumes each person has one dollar. Not all do. This is addressed in no part of this
        document.</li>
      <li>"Efficiency" is used throughout in the technical sense of a ratio, and not in the
        sense of anything working.</li>
      <li>Forward-looking statements in this prospectus are almost certainly false. They are
        included because a prospectus without them would not look like one.</li>
      <li>This document has not been reviewed by counsel. Counsel is the same person and has
        declined to review his own work on grounds of independence.</li>
    </ol>
  </section>

</Company>

<script>
  /* Growth strategy: the sensitivity analysis. */
  const ALIVE = 8.2e9;
  const ASKS = [
    {a:1,          n:'The current plan. One dollar, one in eight. This is where we started.'},
    {a:2,          n:'The refinement. A doubling in efficiency, achieved by typing a different number.'},
    {a:3,          n:'Three dollars. We are now materially ahead of the original plan and have told nobody.'},
    {a:5,          n:'Five dollars. Some would characterise this as a price increase. We characterise it as scale.'},
    {a:10,         n:'An order of magnitude, unlocked without new technology, headcount, or capital.'},
    {a:100,        n:'At one hundred dollars the strategy becomes difficult to distinguish from a normal business.'},
    {a:1000,       n:'One million givers. We are confident that more than one million people exist.'},
    {a:1000000,    n:'One thousand givers. At this scale we could learn all of their names.'},
    {a:1000000000, n:'One person. The limit case, and the most efficient configuration available to us. We are pursuing it in parallel.'},
  ];
  const askLabel = (a: number) => a >= 1e9 ? '$1B' : a >= 1e6 ? '$1M' : '$' + a.toLocaleString('en-US');
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const chips = $('stratChips');

  function setAsk(i: number) {
    const { a, n } = ASKS[i];
    const givers = Math.ceil(1e9 / a);
    const oneIn = ALIVE / givers;
    chips.querySelectorAll('button').forEach((b, j) => {
      b.classList.toggle('on', j === i);
      b.setAttribute('aria-pressed', String(j === i));
    });
    $('sAsk').textContent = askLabel(a);
    $('sGivers').textContent = givers.toLocaleString('en-US');
    $('sRatio').textContent = '1 in ' + (oneIn < 100 ? oneIn.toFixed(1) : Math.round(oneIn).toLocaleString('en-US'));
    $('sGain').textContent = a === 1 ? '\u2014' : (a >= 1e6 ? askLabel(a).replace('$', '') : a + '\u00d7') + ' better';
    ['sAsk', 'sGivers', 'sRatio', 'sGain'].forEach(id => {
      const el = $(id), len = (el.textContent || '').length;
      el.className = 'v' + (len > 13 ? ' t4' : len > 10 ? ' t3' : len > 6 ? ' t2' : '');
    });
    $('sNote').textContent = n;
  }

  if (chips) {
    ASKS.forEach((x, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = askLabel(x.a);
      b.addEventListener('click', () => setAsk(i));
      chips.appendChild(b);
    });
    setAsk(0);
  }
</script>
